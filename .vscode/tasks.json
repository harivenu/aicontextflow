{
  "version": "2.0.0",
  "tasks": [
    {
      "type": "npm",
      "script": "package",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": "$esbuild"
    },
    {
      "type": "npm",
      "script": "pretest",
      "group": "test",
      "problemMatcher": "$tsc"
    }
  ]
}
